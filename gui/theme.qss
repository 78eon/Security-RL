* { font-family: "IBM Plex Sans", "Segoe UI", sans-serif; font-size: 12px; color: #e8f0f1; }
QWidget, QMainWindow, QWidget#Root { background: #071013; }
QFrame#Sidebar { background: #071114; border-right: 1px solid #17262b; }
QLabel#Brand { font-size: 15px; font-weight: 700; letter-spacing: 2px; color: #e8f0f1; }
QLabel#BrandSub, QLabel#Eyebrow, QLabel#Muted, QLabel#MetricLabel { color: #60787e; }
QLabel#Eyebrow, QLabel#MetricLabel { font-size: 9px; letter-spacing: 2px; }
QLabel#PageTitle { font-size: 23px; font-weight: 650; }
QLabel#SectionTitle { font-size: 13px; font-weight: 650; }
QPushButton#Nav { text-align: left; border: 0; border-radius: 6px; padding: 11px 12px; color: #789096; background: transparent; }
QPushButton#Nav:hover { background: #0e2024; color: #dce9eb; }
QPushButton#Nav:checked { background: #0e2024; color: #48dbe2; border-left: 2px solid #48dbe2; }
QPushButton#Primary, QPushButton#Action { border: 1px solid #2c6668; border-radius: 5px; padding: 8px 13px; background: #123035; color: #8ce6e9; }
QPushButton#Action { border-color: #21373c; background: #0c191d; color: #91a7aa; }
QPushButton#Primary:hover, QPushButton#Action:hover { border-color: #48dbe2; color: #e8f0f1; }
QFrame#Panel, QFrame#Metric, QFrame#CampaignCard { background: #0a1619; border: 1px solid #1c3035; border-radius: 7px; }
QFrame#Metric { background: #0d1b1f; }
QLabel#MetricValue { font-family: "IBM Plex Mono", "Consolas", monospace; font-size: 26px; font-weight: 650; color: #48dbe2; }
QLabel#MetricGood { font-family: "IBM Plex Mono", "Consolas", monospace; font-size: 26px; font-weight: 650; color: #b7f04a; }
QLabel#MetricWarn { font-family: "IBM Plex Mono", "Consolas", monospace; font-size: 26px; font-weight: 650; color: #ffba52; }
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox { min-height: 32px; border: 1px solid #20363b; border-radius: 4px; background: #091416; padding: 0 9px; selection-background-color: #20575b; }
QComboBox::drop-down { border: 0; width: 22px; }
QProgressBar { height: 5px; border: 0; background: #172d31; text-align: center; color: transparent; }
QProgressBar::chunk { background: #48dbe2; }
QTableWidget { border: 0; background: #0a1619; alternate-background-color: #0d1b1f; gridline-color: #172b30; selection-background-color: #133138; }
QHeaderView::section { background: #0b171b; color: #647d82; border: 0; border-bottom: 1px solid #1c3035; padding: 9px; font-size: 9px; }
QTableWidget::item { padding: 8px; border-bottom: 1px solid #14272b; }
QTabWidget::pane { border: 0; } QTabBar::tab { padding: 8px 13px; color: #647c81; background: #091316; border: 1px solid #1d3035; }
QTabBar::tab:selected { background: #173036; color: #48dbe2; }
QScrollArea, QScrollArea > QWidget > QWidget { border: 0; background: #071013; }
QScrollBar:vertical { background: #081316; width: 8px; }
QScrollBar::handle:vertical { background: #20363b; border-radius: 4px; min-height: 30px; }
QGroupBox { border: 1px solid #1c3035; border-radius: 6px; margin-top: 12px; padding-top: 12px; font-weight: 650; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; color: #b9c7c9; }
QCheckBox { spacing: 8px; } QCheckBox::indicator { width: 28px; height: 15px; border-radius: 8px; background: #23353a; }
QCheckBox::indicator:checked { background: #48dbe2; }
QTextEdit, QPlainTextEdit { border: 1px solid #1c3035; background: #081316; color: #9ecbd0; font-family: "IBM Plex Mono", "Consolas", monospace; }
QStatusBar { background: #071013; border-top: 1px solid #14262a; color: #60787e; }
QToolTip { background: #112426; color: #e8f0f1; border: 1px solid #285150; }
