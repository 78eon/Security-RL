/* RLRedTeam analyst skin.
 *
 * Tokens of the form AT-NAME-AT are substituted by theme.build_stylesheet(),
 * so colours cannot drift between here and the code that paints charts and
 * graphics items, which QSS cannot reach.
 *
 * Flat by design: every border is 1px solid, corner radius is 0 everywhere, and
 * nothing relies on shadows, gradients or transforms -- all of which QSS either
 * cannot do or renders unreliably.
 */

QWidget {
    background: @WINDOW@;
    color: @TEXT@;
    font-family: "@FONT_SANS@";
    font-size: @SIZE_BODY@px;
}

QMainWindow, QDialog { background: @WINDOW@; }

/* -- nav rail ----------------------------------------------------------- */

#navRail {
    background: @PANEL@;
    border-right: 1px solid @BORDER@;
}
#navRail QPushButton {
    background: transparent;
    border: 0;
    border-left: 2px solid transparent;
    padding: 9px 14px;
    text-align: left;
    color: @TEXT_SECONDARY@;
    font-size: @SIZE_BODY@px;
}
#navRail QPushButton:hover { background: @SURFACE@; color: @TEXT@; }
#navRail QPushButton:checked {
    background: @SURFACE@;
    border-left: 2px solid @ARM_1@;
    color: @TEXT@;
}

#appTitle {
    background: @PANEL@;
    color: @TEXT_SECONDARY@;
    font-family: "@FONT_MONO@";
    font-size: @SIZE_SMALL@px;
    padding: 10px 14px;
    border-bottom: 1px solid @BORDER@;
}

/* -- panels ------------------------------------------------------------- */

#surface { background: @SURFACE@; }
#panel   { background: @PANEL@; border-left: 1px solid @BORDER@; }

#viewTitle {
    font-size: @SIZE_TITLE@px;
    font-weight: 600;
    color: @TEXT@;
    background: transparent;
}
#viewSubtitle {
    color: @TEXT_TERTIARY@;
    font-size: @SIZE_SMALL@px;
    background: transparent;
}
#panelHeading {
    font-size: @SIZE_HEADING@px;
    font-weight: 600;
    color: @TEXT@;
    background: transparent;
}
#sectionLabel {
    font-family: "@FONT_MONO@";
    font-size: @SIZE_LABEL@px;
    color: @TEXT_TERTIARY@;
    background: transparent;
}
#mono, #monoValue {
    font-family: "@FONT_MONO@";
    font-size: @SIZE_MONO@px;
    color: @TEXT_BRIGHT@;
    background: transparent;
}
#muted { color: @TEXT_SECONDARY@; background: transparent; }

/* -- metric tile -------------------------------------------------------- */

#metricTile {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
}
#metricValue {
    font-family: "@FONT_MONO@";
    font-size: 27px;
    font-weight: 500;
    color: @TEXT@;
    background: transparent;
}
#metricLabel {
    font-family: "@FONT_MONO@";
    font-size: @SIZE_LABEL@px;
    color: @TEXT_TERTIARY@;
    background: transparent;
}
#metricDelta {
    font-family: "@FONT_MONO@";
    font-size: @SIZE_SMALL@px;
    color: @TEXT_SECONDARY@;
    background: transparent;
}

/* -- tables ------------------------------------------------------------- */

QTableView {
    background: @SURFACE@;
    alternate-background-color: @SURFACE@;
    gridline-color: @RULE@;
    border: 1px solid @BORDER@;
    selection-background-color: @SELECTION@;
    selection-color: @TEXT@;
    outline: 0;
}
QTableView::item { padding: 0px 10px; border-bottom: 1px solid @RULE@; }
QTableView::item:selected { background: @SELECTION@; color: @TEXT@; }
QTableView::item:hover { background: @HEADER@; }

QHeaderView::section {
    background: @HEADER@;
    color: @TEXT_TERTIARY@;
    font-family: "@FONT_MONO@";
    font-size: @SIZE_LABEL@px;
    padding: 8px 10px;
    border: 0;
    border-bottom: 1px solid @BORDER@;
    border-right: 1px solid @RULE@;
}
QTableView QTableCornerButton::section { background: @HEADER@; border: 0; }

/* -- buttons ------------------------------------------------------------ */

QPushButton {
    background: @HEADER@;
    border: 1px solid @BORDER_STRONG@;
    padding: 6px 12px;
    color: @TEXT@;
}
QPushButton:hover { background: @RAISED@; }
QPushButton:pressed { background: @PANEL@; }
QPushButton:disabled { color: @TEXT_MUTED@; border-color: @BORDER@; }
QPushButton[primary="true"] {
    background: @PRIMARY_FILL@;
    border: 1px solid @ARM_1@;
    color: @ARM_1_LIGHT@;
}
QPushButton[primary="true"]:hover { background: #21385a; }
QPushButton[danger="true"] {
    background: #241519;
    border: 1px solid @ERROR@;
    color: @ERROR_TEXT@;
}

/* -- inputs ------------------------------------------------------------- */

QLineEdit, QSpinBox, QComboBox {
    background: @SURFACE@;
    border: 1px solid @BORDER_STRONG@;
    padding: 5px 8px;
    color: @TEXT@;
    selection-background-color: @ARM_1@;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 1px solid @ARM_1@; }
QComboBox::drop-down { border: 0; width: 18px; }
QComboBox QAbstractItemView {
    background: @HEADER@;
    border: 1px solid @BORDER_STRONG@;
    selection-background-color: @SELECTION@;
}
QCheckBox { spacing: 7px; background: transparent; }
QCheckBox::indicator {
    width: 13px; height: 13px;
    border: 1px solid @BORDER_STRONG@;
    background: @SURFACE@;
}
QCheckBox::indicator:checked { background: @ARM_1@; border-color: @ARM_1@; }

/* -- segmented toggle --------------------------------------------------- */
/* Native is correct and default; shaped must feel deliberate, so the two
 * segments are visually asymmetric when shaped is active. */

#segment QPushButton {
    background: @SURFACE@;
    border: 1px solid @BORDER_STRONG@;
    padding: 5px 14px;
    color: @TEXT_SECONDARY@;
}
#segment QPushButton:checked {
    background: @PRIMARY_FILL@;
    border-color: @ARM_1@;
    color: @ARM_1_LIGHT@;
}
#segment QPushButton[warnState="true"]:checked {
    background: @TINT_WARN@;
    border-color: @WARN@;
    color: @WARN_TEXT@;
}

/* -- log ---------------------------------------------------------------- */

QPlainTextEdit {
    background: @PANEL@;
    border: 1px solid @BORDER@;
    color: @TEXT_SECONDARY@;
    font-family: "@FONT_MONO@";
    font-size: @SIZE_SMALL@px;
    selection-background-color: @SELECTION@;
}

/* -- misc --------------------------------------------------------------- */

QSplitter::handle { background: @BORDER@; width: 1px; }
QStatusBar {
    background: @PANEL@;
    border-top: 1px solid @BORDER@;
    color: @TEXT_TERTIARY@;
    font-family: "@FONT_MONO@";
    font-size: @SIZE_LABEL@px;
}
QStatusBar::item { border: 0; }

QScrollBar:vertical { background: @WINDOW@; width: 11px; margin: 0; }
QScrollBar::handle:vertical { background: @BORDER_STRONG@; min-height: 24px; }
QScrollBar::handle:vertical:hover { background: @BORDER_SOFT@; }
QScrollBar:horizontal { background: @WINDOW@; height: 11px; margin: 0; }
QScrollBar::handle:horizontal { background: @BORDER_STRONG@; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QToolTip {
    background: @HEADER@;
    border: 1px solid @BORDER_STRONG@;
    color: @TEXT@;
    padding: 4px 7px;
}

QProgressBar {
    background: @SURFACE@;
    border: 1px solid @BORDER@;
    height: 6px;
    text-align: center;
}
QProgressBar::chunk { background: @ARM_1@; }
