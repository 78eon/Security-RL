* {
    font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
    font-size: 13px;
    color: #e8f0f1;
}
QWidget, QMainWindow, QWidget#Root { background: #071013; }
QFrame#Sidebar {
    background: #071114;
    border-right: 1px solid #1c3035;
}
QLabel#Brand {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 2px;
    color: #e8f0f1;
}
QLabel#BrandSub, QLabel#Eyebrow, QLabel#MetricLabel, QLabel#FieldLabel {
    color: #72888e;
    font-size: 10px;
    letter-spacing: 1.5px;
}
QLabel#Muted { color: #7f969b; }
QLabel#PageTitle { font-size: 18px; font-weight: 600; }
QLabel#ViewTitle { font-size: 25px; font-weight: 650; }
QLabel#HeroTitle { font-size: 21px; font-weight: 650; color: #ffffff; }
QLabel#SectionTitle { font-size: 13px; font-weight: 650; color: #d6e3e5; }
QLabel#MonoDetail {
    color: #86a5aa;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 11px;
}
QLabel#DatasetValue {
    color: #d6e3e5;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 22px;
    font-weight: 600;
}
QLabel#StateLabel {
    color: #b7f04a;
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 1px;
    min-width: 88px;
}
QLabel#StateLabel[kind="warn"] { color: #ffba52; }

QPushButton#Nav {
    min-height: 38px;
    text-align: left;
    border: 0;
    border-radius: 4px;
    padding: 0 12px;
    color: #89a0a5;
    background: transparent;
}
QPushButton#Nav:hover { background: #0e2024; color: #e8f0f1; }
QPushButton#Nav:checked {
    background: #10262a;
    color: #48dbe2;
    border-left: 3px solid #48dbe2;
}
QPushButton#Primary, QPushButton#Action {
    min-height: 34px;
    border: 1px solid #2b5d62;
    border-radius: 4px;
    padding: 0 14px;
    background: #123035;
    color: #a4e9eb;
}
QPushButton#Action {
    border-color: #294147;
    background: #0b191c;
    color: #a3b5b8;
}
QPushButton#Primary:hover, QPushButton#Action:hover {
    border-color: #48dbe2;
    color: #ffffff;
}
QPushButton:disabled { color: #526b71; border-color: #1c3035; background: #0a1518; }

QFrame#Panel, QFrame#Metric, QFrame#HeroPanel, QFrame#DatasetCard,
QFrame#BoundaryPanel, QFrame#StateBanner {
    background: #0a1619;
    border: 1px solid #1c3035;
    border-radius: 5px;
}
QFrame#HeroPanel { background: #0c1c20; border-left: 3px solid #48dbe2; }
QFrame#Metric { background: #0d1b1f; min-height: 92px; }
QFrame#StateBanner { background: #0b1a1d; border-left: 3px solid #b7f04a; }
QFrame#BoundaryPanel { background: #091619; }
QLabel#MetricValue {
    font-family: "IBM Plex Mono", "Consolas", monospace;
    font-size: 25px;
    font-weight: 650;
    color: #48dbe2;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    min-height: 34px;
    border: 1px solid #294147;
    border-radius: 4px;
    background: #081316;
    padding: 0 10px;
    selection-background-color: #20575b;
}
QComboBox::drop-down { border: 0; width: 24px; }
QTableWidget {
    border: 0;
    background: #0a1619;
    alternate-background-color: #0d1b1f;
    gridline-color: #1a3035;
    selection-background-color: #17363c;
    selection-color: #ffffff;
}
QHeaderView::section {
    background: #0b171b;
    color: #7c9398;
    border: 0;
    border-bottom: 1px solid #294147;
    padding: 10px 9px;
    font-size: 10px;
    font-weight: 600;
}
QTableWidget::item { padding: 8px; border-bottom: 1px solid #172b30; }
QGraphicsView#EnterpriseGraph { border: 1px solid #1c3035; background: #071114; }
QScrollArea, QScrollArea > QWidget > QWidget { border: 0; background: #071013; }
QScrollBar:vertical { background: #081316; width: 10px; }
QScrollBar::handle:vertical { background: #294147; border-radius: 4px; min-height: 32px; }
QScrollBar:horizontal { background: #081316; height: 10px; }
QScrollBar::handle:horizontal { background: #294147; border-radius: 4px; min-width: 32px; }
QStatusBar { background: #071013; border-top: 1px solid #1c3035; color: #72888e; }
QToolTip { background: #112426; color: #e8f0f1; border: 1px solid #2c555b; }
