# Secrets — NVD API key lives here, never committed
.env
configs/lab_scope.yaml
.agents/

# Project documentation and dissertation drafts are kept local, not published.
# Only the research-integrity records below are part of the reproducible system.
docs/*
!docs/IMPLEMENTATION_STATUS.md
!docs/REWARD_SPECIFICATION.md
!docs/TRAJECTORY_VALIDATION.md
!docs/PHASE_*.md

# Generated by scripts/export_fixtures.py. Regenerate rather than commit —
# nothing depends on them, and they are derived from the database.
tests/fixtures/

# Trained attack-policy weights are gated by default (charter §10, dual-use)
runs/
results/
*.zip
*.pt

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
.venv-*/
venv/

# Test / tooling
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# SQLite transient files (the catalogue itself IS committed)
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# OS
.directory
.DS_Store

# Packaged weight bundles — dual-use, released only by explicit decision (CP-31)
dist/
