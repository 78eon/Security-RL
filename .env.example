# Copy to .env and fill in. .env is gitignored — never commit it.
#
# There are NO defaults for these. A missing value stops startup rather than
# silently falling back to a known password (CP-01).
POSTGRES_USER=rlredteam
POSTGRES_PASSWORD=CHANGE_ME_generate_a_strong_value
POSTGRES_DB=rlredteam
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# NVD API key, requested at https://nvd.nist.gov/developers/request-an-api-key
# Used ONLY by tools/fetch_nvd.py, a one-shot ONLINE tool run outside the
# training network. Training never reads it and has no route to the internet.
NVD_API_KEY=
