# Copy to .env and fill in. .env is gitignored — never commit it.
#
# NVD API key, requested at https://nvd.nist.gov/developers/request-an-api-key
# Used ONLY by tools/fetch_nvd.py, which is a one-shot online tool.
# Training code never reads this and never touches the network.
NVD_API_KEY=

# PostgreSQL (Module 4). Host port 5433 to avoid clashing with a local 5432.
POSTGRES_USER=rlredteam
POSTGRES_PASSWORD=rlredteam
POSTGRES_DB=rlredteam
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
